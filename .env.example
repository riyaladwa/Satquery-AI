# ==========================================================
# SatQuery AI — Environment Variables & Supabase Integration
# ==========================================================

# 1. Supabase Frontend Configuration (Required for Supabase Auth & Storage in UI)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# 2. Supabase Backend Configuration (FastAPI Storage & Administration)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SUPABASE_STORAGE_BUCKET=satellite-images

# 3. Supabase Database URL (PostgreSQL Connection String)
# Find in Supabase Project Settings -> Database -> Connection string -> URI
# Example: postgresql://postgres.xxxx:your_password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# 4. Multimodal AI Specialist (Optional)
# Optional Google Gemini 1.5 Pro / Flash API Key for dynamic EO vision reasoning
GEMINI_API_KEY=

# 5. Frontend Backend URL
# Leave blank for local development (uses Vite proxy to http://localhost:8000)
# VITE_API_URL=http://localhost:8000
